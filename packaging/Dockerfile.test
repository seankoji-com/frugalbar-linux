FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-gi python3-cairo python3-gi-cairo gir1.2-gtk-3.0 gir1.2-xapp-1.0 libsecret-tools xvfb xauth dbus-x11 librsvg2-common adwaita-icon-theme ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /work
CMD ["sh", "scripts/check-linux.sh"]
